    "contamination": 0.035,
    "n_estimators": 150,
    "features": [
      "ph",
      "turbidity_ntu",
      "tds_ppm",
      "ec_us_cm",
      "turbidity_change_rate",
      "ph_change_rate"
    ]
  },
  "explainability": {
    "shap": {
      "sample_size": 250,
