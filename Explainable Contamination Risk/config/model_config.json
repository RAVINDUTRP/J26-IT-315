{
  "random_state": 42,
  "test_split_ratio": 0.20,
  "validation_split_ratio": 0.15,
  "cv_folds": 5,
  "baseline": {
    "logistic_regression": {
      "C": 1.0,
      "max_iter": 1000,
      "class_weight": "balanced",
      "solver": "lbfgs"
    },
    "random_forest": {
      "n_estimators": 150,
      "max_depth": 10,
      "min_samples_split": 5,
      "min_samples_leaf": 2,
      "class_weight": "balanced",
      "n_jobs": -1
    }
  },
  "xgboost": {
    "n_estimators": 250,
    "max_depth": 5,
    "learning_rate": 0.05,
    "subsample": 0.85,
    "colsample_bytree": 0.85,
    "scale_pos_weight": 2.5,
    "eval_metric": "logloss",
    "early_stopping_rounds": 25
  },
  "lstm": {
    "sequence_length": 12,
    "units": [64, 32],
    "dropout": 0.20,
    "recurrent_dropout": 0.10,
    "dense_units": 16,
    "learning_rate": 0.001,
    "batch_size": 256,
