{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Transmission envelope (Component 2 wraps an Observation)",
  "type": "object",
  "required": ["node_id", "path", "path_health", "auth_tag", "payload"],
  "properties": {
    "node_id": { "type": "string" },
    "path": { "type": "array", "items": { "type": "string" }, "example": ["S1", "R2", "R5", "GW"] },
    "path_health": { "type": "number", "minimum": 0, "maximum": 1 },
    "predicted_degradation": { "type": "number", "minimum": 0, "maximum": 1 },
    "auth_tag": { "type": "string" },
    "payload": { "$ref": "observation.schema.json" }
  }
}
