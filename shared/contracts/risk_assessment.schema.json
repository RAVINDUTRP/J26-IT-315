{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Risk assessment (Component 3 -> Component 4)",
  "type": "object",
  "required": ["site_id", "timestamp", "location", "horizon_h", "risk_score", "risk_category", "confidence", "explanation", "anomaly"],
  "properties": {
    "site_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "location": { "type": "object" },
    "horizon_h": { "type": "integer", "description": "forecast horizon in hours" },
    "risk_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "risk_category": { "enum": ["low", "moderate", "high", "critical"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "explanation": { "type": "array", "items": { "type": "object", "properties": { "feature": {"type":"string"}, "contribution": {"type":"number"} } } },
    "anomaly": { "type": "object", "properties": { "flag": {"type":"boolean"}, "kind": {"enum":["none","pollution_pattern","sensor_fault"]}, "score": {"type":"number"} } }
  }
}
